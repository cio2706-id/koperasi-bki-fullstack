# Development Environment Variables
# Copy this file to .env and modify as needed

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Authentication
BETTER_AUTH_SECRET=your_secret_key_here_change_this_in_production
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Accurate.id API Configuration
ACCURATE_API_BASE_URL=https://accurate.id
ACCURATE_API_CLIENT_ID=your_accurate_client_id
ACCURATE_API_CLIENT_SECRET=your_accurate_client_secret
ACCURATE_API_DATABASE_ID=your_database_id

# File Upload Configuration
NEXT_PUBLIC_FILE_UPLOAD_MAX_SIZE=10485760  # 10MB in bytes
FILE_UPLOAD_BUCKET=your_s3_bucket_name
FILE_UPLOAD_REGION=your_s3_region
FILE_UPLOAD_ACCESS_KEY=your_s3_access_key
FILE_UPLOAD_SECRET_KEY=your_s3_secret_key

# Email Configuration (for magic links)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
FROM_EMAIL=noreply@koperasibk.co.id

# Application Configuration
NEXT_PUBLIC_APP_NAME=Koperasi Pegawai BKI
NEXT_PUBLIC_APP_URL=http://localhost:3000